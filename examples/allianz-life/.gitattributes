# Line endings for this repository
# See: https://help.github.com/en/articles/configuring-git-to-handle-line-endings
# This should line up with the expectations from .eslintrc

# Set the default behavior, in case people don't have core.autocrlf set.
* text=crlf

# Declare files that will always have CRLF line endings on checkout.
*.ts text eol=crlf
*.tsx text eol=crlf
*.js text eol=crlf

# Preserve exact original Strategy engine, stylesheet and XLSX bytes.
public/allianz-assets/rila-strategy/* -text
public/~/Media/Files/Global/ToolShed/dx-index-advantage-may-1/dx-index-advantage-xlsx.xlsx -text
public/~/Media/Files/Global/ToolShed/dx-index-advantage-may-1/iva.xlsx -text
