{
  "$schema": "../../.sitecore/schemas/ModuleFile.schema.json",
  "namespace": "NWN.Site",
  "description": "Narrow serialization boundary for the NW Natural site, site-scoped presentation, and NWN component definitions.",
  "items": {
    "path": "nwn-site",
    "includes": [
      {
        "name": "nwn.site.content",
        "path": "/sitecore/content/utilities/kit-nextjs-nwn",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "nwn.site.templates",
        "path": "/sitecore/templates/Project/NWN",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "nwn.site.renderings",
        "path": "/sitecore/layout/Renderings/Project/NWN",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "nwn.site.placeholder-settings",
        "path": "/sitecore/layout/Placeholder Settings/Project/NWN",
        "allowedPushOperations": "CreateUpdateAndDelete"
      }
    ]
  }
}
