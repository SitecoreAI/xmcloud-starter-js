{
  "$schema": "../../.sitecore/schemas/ModuleFile.schema.json",
  "namespace": "kirkland-page-branches",
  "description": "Kirkland page-branch insert rules, authoring guardrails, and the reusable Lawyer Profile, News Article, and Practice Area page branches.",
  "items": {
    "path": "kirkland-page-branches",
    "includes": [
      {
        "name": "kirkland.page-branches.rules",
        "path": "/sitecore/content/legal/kit-nextjs-kirkland/Presentation/Page Branches",
        "scope": "singleItem",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "kirkland.page-branches.available-renderings",
        "path": "/sitecore/content/legal/kit-nextjs-kirkland/Presentation/Available Renderings",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "kirkland.page-branches.lawyer-profile",
        "path": "/sitecore/content/legal/kit-nextjs-kirkland/Presentation/Page Branches/Lawyer Profile",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "kirkland.page-branches.news-article",
        "path": "/sitecore/content/legal/kit-nextjs-kirkland/Presentation/Page Branches/News Article",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "kirkland.page-branches.practice-area",
        "path": "/sitecore/content/legal/kit-nextjs-kirkland/Presentation/Page Branches/Practice Area",
        "allowedPushOperations": "CreateUpdateAndDelete"
      }
    ]
  }
}
