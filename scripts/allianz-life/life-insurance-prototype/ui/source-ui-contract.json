        "partnerAge",
        "partnerAnnualIncome",
        "partnerRetirementAge"
      ],
      "intro": "First we'll need some basic information about you and your spouse or domestic partner, if applicable."
    },
    {
      "id": "one-time-costs",
      "name": "One-time costs",
      "schemaGroup": "OneTimeCosts",
      "fields": [
        "finalExpenses",
        "currentMortgageBalance",
        "debts"
      ],
      "intro": "Now we'll ask you questions about larger, one-time costs. For some questions, we've set a national average as a placeholder. If you don't know the answer for your particular situation, you may choose to leave the number we've set until you have a clearer answer. Please be aware that your results may not be as accurate as a result."
    },
    {
      "id": "long-term-income-needs",
      "name": "Long-term income needs",
      "schemaGroup": "LongTermIncome",
      "fields": [
        "desiredAnnualIncome",
        "yearsIncomeNeeded",
        "collegeCosts"
      ],
      "intro": "This section will address your long-term income needs and goals."
    },
    {
      "id": "available-assets",
      "name": "Available assets",
      "schemaGroup": "AvailableAssets",
      "fields": [
        "inflationRate",
        "investmentAssets",
        "returnRate",
        "currentLifeInsurance",
        "socialSecuritySurvivorBenefit"
      ],
      "intro": "In this section we'll ask you about your current investments, including any current life insurance."
    },
    {
      "id": "summary",
      "name": "Summary",
      "fields": [],
      "intro": "The information on this screen is calculated from your answers on previous screens. You can adjust your outcome by going back to the various sections and adjusting your answers. Use the menu buttons to jump to whichever section you would like to revisit."
    }
